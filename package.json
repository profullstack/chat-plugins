{
  "name": "@profullstack/chat-plugins",
  "version": "0.3.0",
  "type": "module",
  "description": "Chat plugins = remote MCP servers, with less hoops than connectors: paste a URL or pick from a catalog, sign-in is automatic (OAuth 2.1 + DCR + PKCE), and an agent loop runs the tools even on models with no native tool calling. Zero dependencies.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "plugins",
    "connectors",
    "oauth",
    "dcr",
    "pkce",
    "tool-calling",
    "agent",
    "ollama",
    "c0mpute",
    "infernet"
  ],
  "license": "MIT",
  "author": "Profullstack, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/chat-plugins.git"
  },
  "homepage": "https://github.com/profullstack/chat-plugins#readme",
  "bugs": {
    "url": "https://github.com/profullstack/chat-plugins/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
